{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "."
  },
  "include": [
    "electron/**/*.ts",
    "packages/database/**/*.ts",
    "packages/shared/**/*.ts",
    "electron/**/*.cts"
  ],
  "exclude": ["**/*.test.ts"]
}
