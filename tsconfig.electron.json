{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "."
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "packages/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
