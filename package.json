{
  "name": "market-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "npm run build:electron && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "start": "electron .",
    "test": "npm run build:electron && vitest run",
    "test:browser": "node scripts/check-browser.mjs",
    "format": "prettier --write src packages electron scripts",
    "test:desktop": "node scripts/check-desktop.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable zip --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win --dir --x64 --publish never",
    "mcp": "node dist-electron/packages/mcp-server/src/cli.js",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "mcp:config": "node scripts/mcp-config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.44.0",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "description": "Laboratório de simulação de mercados de criptomoedas",
  "author": "Market Lab contributors",
  "license": "MIT",
  "build": {
    "appId": "io.marketlab.desktop",
    "productName": "Market Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "Market-Lab-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Market-Lab-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Market Lab",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Market-Lab-${version}-Portable-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/3squeleeet/Market-Lab.git"
  }
}
